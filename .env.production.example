# ==========================================
# SlotAlert - Production Environment Variables
# ==========================================

# Application Settings
PROJECT_NAME="SlotAlert"
ENVIRONMENT="production"
WEB_CONCURRENCY=4
AUTO_SEED=false

# Domain & Public URLs
DOMAIN=your-domain.com
BASE_WEB_URL=https://your-domain.com
ALLOWED_ORIGINS=["https://your-domain.com"]

# Database (PostgreSQL 16)
POSTGRES_USER=slotalert_prod
POSTGRES_PASSWORD=ChangeThisToAStrongProdPassword_987!
POSTGRES_DB=slotalert_production
DATABASE_URL=postgresql+asyncpg://slotalert_prod:ChangeThisToAStrongProdPassword_987!@postgres:5432/slotalert_production

# Cache & Task Queue (Redis 7)
REDIS_URL=redis://redis:6379/0

# Security & Business Authentication
JWT_SECRET=generate_a_random_32_byte_secret_key_here_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
MASTER_ADMIN_KEY=set_a_secure_master_key_for_emergency_owner_bypass

# Meta WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=EAAG...YOUR_LONG_LIVED_META_USER_OR_SYSTEM_TOKEN
WHATSAPP_PHONE_NUMBER_ID=109283746592817
WHATSAPP_VERIFY_TOKEN=slotalert_webhook_secret_verify_token_prod
WHATSAPP_APP_SECRET=your_meta_app_secret_for_sha256_signature_verification
WHATSAPP_API_VERSION=v20.0

# Optional Initial Tenant Bootstrap
INITIAL_BUSINESS_NAME="קליניקת שירן"
INITIAL_BUSINESS_PHONE="+972501112233"
INITIAL_BUSINESS_SLUG="shiran-clinic"
INITIAL_BUSINESS_TYPE="clinic"
